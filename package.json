{
  "name": "ibima-assist-website",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate / marketing website for the IBima Assist claims-technology platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server --watch-path=src/data server/index.js",
    "server": "node server/index.js",
    "test:api": "node scripts/test-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build --ssr scripts/smoke.jsx --outDir .smoke --emptyOutDir --logLevel warn && node .smoke/smoke.js",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:images": "node scripts/image-coverage.mjs",
    "report:images": "node scripts/image-map-report.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "antd": "^6.3.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.28.0",
    "mongoose": "^9.10.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  }
}
